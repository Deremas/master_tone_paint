---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import SectionIcon from '../components/SectionIcon.astro';
import { company, homeHighlights, products, seo, stats, values } from '../data/content';
---
<Base title="Home" description={seo.homeDescription}>
  <!-- Peak-End Rule: strong first impression with one clear goal -->
  <section class="hero hero--simple">
    <div class="container hero-simple">
      <div class="hero-copy" data-reveal>
        <div class="eyebrow">
          <span class="eyebrow-dot"></span>
          {company.shortName} · Addis Ababa
        </div>
        <h1>{homeHighlights.hero.title}</h1>
        <p>{homeHighlights.hero.description}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/products/">View Products</a>
          <a class="btn btn-secondary" href="/contact/#inquiry-form">Request a Quote</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Chunking: three capacity facts only -->
  <section class="section section--tight section-pattern">
    <div class="container">
      <div class="stats-grid stats-grid--three">
        {stats.map((stat) => (
          <article class="stat-card stat-card--icon" data-reveal>
            <SectionIcon name={stat.icon} />
            <strong>{stat.value}</strong>
            <span>{stat.label}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-soft section-pattern">
    <div class="container">
      <div class="section-title section-title--stack" data-reveal>
        <div class="eyebrow">
          <span class="eyebrow-dot"></span>
          Products
        </div>
        <h2>Paints and finishes for the full wall journey.</h2>
        <p>From preparation to final coat — five clear product families.</p>
      </div>

      <div class="product-grid product-grid--text">
        {products.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    </div>
  </section>

  <section class="section section-pattern">
    <div class="container about-brief" data-reveal>
      <div>
        <div class="eyebrow">
          <span class="eyebrow-dot"></span>
          About
        </div>
        <h2>{homeHighlights.about.title}</h2>
        <p>{homeHighlights.about.paragraph}</p>
        <a class="text-link" href="/about/">
          About the company
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="value-list">
        {values.map((item) => (
          <article class="value-item">
            <SectionIcon name={item.icon} />
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Peak-End Rule: clear closing action -->
  <section class="section section-navy">
    <div class="container callout-simple" data-reveal>
      <h2>Need paint products in bulk?</h2>
      <p>Tell us what you need. We supply distributors, contractors, and developers.</p>
      <a class="btn btn-light" href="/contact/#inquiry-form">Request a Quote</a>
    </div>
  </section>
</Base>
