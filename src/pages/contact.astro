---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { company, contactTopics, seo } from '../data/content';
---
<Base title="Contact" description={seo.contactDescription}>
  <PageHero
    eyebrow="Contact"
    title="Request a Quote"
    intro="Tell us what you need. We supply distributors, contractors, and developers."
  />

  <section class="section">
    <div class="container contact-grid contact-grid--simple">
      <aside class="contact-aside" data-reveal>
        <div class="eyebrow">
          <span class="eyebrow-dot"></span>
          Location
        </div>
        <h2>{company.location}</h2>
        <p>Factory and warehouse in Ayat Tafo, Addis Ababa. Delivery across the city with our own fleet.</p>

        {company.phone && (
          <div class="contact-item">
            <strong>Phone</strong>
            <p>{company.phone}</p>
          </div>
        )}

        {company.email && (
          <div class="contact-item">
            <strong>Email</strong>
            <p>{company.email}</p>
          </div>
        )}
      </aside>

      <form class="contact-form" id="inquiry-form" action="/api/contact.php" method="post" data-reveal>
        <div>
          <h2>Send a message</h2>
          <p>Share the product and quantity you need. Fields marked * are required.</p>
        </div>

        <div class="form-grid">
          <div class="field field-full">
            <label for="name">Full name <span>*</span></label>
            <input id="name" name="name" type="text" autocomplete="name" required minlength="2" maxlength="120" />
          </div>

          <div class="field">
            <label for="email">Email <span>*</span></label>
            <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" />
          </div>

          <div class="field">
            <label for="phone">Phone</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="35" />
          </div>

          <div class="field field-full">
            <label for="product">Product interest</label>
            <select id="product" name="product">
              {contactTopics.map((topic) => (
                <option value={topic.value}>{topic.label}</option>
              ))}
            </select>
          </div>

          <div class="field field-full">
            <label for="message">Message <span>*</span></label>
            <textarea
              id="message"
              name="message"
              required
              minlength="10"
              maxlength="3000"
              placeholder="Product, approximate volume, and any delivery notes."
            ></textarea>
          </div>
        </div>

        <div class="honeypot" aria-hidden="true">
          <label for="website">Website</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="form-actions">
          <button class="btn btn-primary" type="submit" id="contact-submit">Send Message</button>
          <p class="form-status" id="contact-status" role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </section>

  <script>
    const form = document.getElementById('inquiry-form') as HTMLFormElement | null;
    const status = document.getElementById('contact-status');
    const submitButton = document.getElementById('contact-submit') as HTMLButtonElement | null;
    const productField = document.getElementById('product') as HTMLSelectElement | null;
    const url = new URL(window.location.href);
    const selectedProduct = url.searchParams.get('product');

    const validProductValues = new Set(Array.from(productField?.options ?? []).map((option) => option.value));

    if (productField && selectedProduct && validProductValues.has(selectedProduct)) {
      productField.value = selectedProduct;
    }

    const setStatus = (message: string, state: 'idle' | 'success' | 'error' = 'idle') => {
      if (!status) return;
      status.textContent = message;
      status.dataset.state = state;
    };

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form || !submitButton) return;

      if (!form.reportValidity()) {
        setStatus('Please check the highlighted fields and try again.', 'error');
        return;
      }

      setStatus('Sending your message...');
      submitButton.disabled = true;
      submitButton.setAttribute('aria-busy', 'true');

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' }
        });

        const payload = await response.json().catch(() => null);

        if (!response.ok || !payload?.ok) {
          throw new Error(payload?.message || 'We could not send your message. Please try again later.');
        }

        form.reset();

        if (productField && selectedProduct && validProductValues.has(selectedProduct)) {
          productField.value = selectedProduct;
        }

        setStatus(payload.message || 'Your message was sent successfully.', 'success');
      } catch (error) {
        setStatus(
          error instanceof Error ? error.message : 'We could not send your message. Please try again later.',
          'error'
        );
      } finally {
        submitButton.disabled = false;
        submitButton.removeAttribute('aria-busy');
      }
    });
  </script>
</Base>
