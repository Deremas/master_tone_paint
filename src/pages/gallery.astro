---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { galleryItems, seo } from '../data/content';
---
<Base title="Gallery" description={seo.galleryDescription}>
  <PageHero
    eyebrow="Inspiration"
    title="Applications"
    intro="A short look at how paint and coatings can finish interior and exterior surfaces."
  />

  <section class="section">
    <div class="container">
      <div class="gallery-grid gallery-grid--compact">
        {galleryItems.map((item, index) => (
          <figure class="gallery-card gallery-card--static" data-reveal>
            <div class="photo-frame photo-frame--gallery">
              <img
                src={`/assets/photos/${item.imageSlug}.png`}
                alt={item.imageAlt}
                loading={index < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </div>
            <figcaption class="gallery-body">
              <h3>{item.title}</h3>
              <p>{item.caption}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
</Base>
