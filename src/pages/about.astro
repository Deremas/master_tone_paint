---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import {
  aboutSections,
  company,
  coreValues,
  foreword,
  futureExpansion,
  seo,
  stats
} from '../data/content';
---
<Base title="About" description={seo.aboutDescription}>
  <PageHero
    eyebrow="About"
    title="About Master Tone Paint"
    intro={aboutSections.introduction}
  />

  <section class="section">
    <div class="container" data-reveal>
      <article class="foreword">
        <div class="eyebrow">
          <span class="eyebrow-dot"></span>
          Co-Founder Message
        </div>
        <h2>{foreword.title}</h2>
        {foreword.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        <footer class="foreword-author">
          <strong>{foreword.author}</strong>
          <span>{foreword.role}</span>
        </footer>
      </article>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container prose-narrow" data-reveal>
      <div class="eyebrow">
        <span class="eyebrow-dot"></span>
        Who We Are
      </div>
      <h2>An Ethiopian manufacturer with roots in the supply chain.</h2>
      <p>{aboutSections.whoWeAre}</p>
      <p>{aboutSections.whatWeDo}</p>
    </div>
  </section>

  <section class="section">
    <div class="container split-grid">
      <article class="split-card" data-reveal>
        <div class="eyebrow">
          <span class="eyebrow-dot"></span>
          Vision
        </div>
        <p>{company.vision}</p>
      </article>
      <article class="split-card" data-reveal>
        <div class="eyebrow">
          <span class="eyebrow-dot"></span>
          Mission
        </div>
        <p>{company.mission}</p>
      </article>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-title section-title--stack" data-reveal>
        <div class="eyebrow">
          <span class="eyebrow-dot"></span>
          Core Values
        </div>
        <h2>What guides how we work.</h2>
      </div>

      <div class="value-grid">
        {coreValues.map((item) => (
          <article class="value-item" data-reveal>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-title section-title--stack" data-reveal>
        <div class="eyebrow">
          <span class="eyebrow-dot"></span>
          Capacity
        </div>
        <h2>Factory at a glance</h2>
        <p>{aboutSections.capabilities}</p>
      </div>

      <div class="stats-grid stats-grid--three">
        {stats.map((stat) => (
          <article class="stat-card" data-reveal>
            <strong>{stat.value}</strong>
            <span>{stat.label}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container prose-narrow" data-reveal>
      <div class="eyebrow">
        <span class="eyebrow-dot"></span>
        Who We Serve
      </div>
      <h2>Partners across the construction chain.</h2>
      <p>{aboutSections.customers}</p>
      <ul class="stack-list">
        <li>Wholesale distributors</li>
        <li>Construction companies</li>
        <li>Real estate developers</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-title section-title--stack" data-reveal>
        <div class="eyebrow">
          <span class="eyebrow-dot"></span>
          Future Expansion
        </div>
        <h2>Where we are headed next.</h2>
      </div>

      <div class="value-grid value-grid--two">
        {futureExpansion.map((item) => (
          <article class="value-item" data-reveal>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose-narrow" data-reveal>
      <a class="btn btn-primary" href="/contact/#inquiry-form">Contact Us</a>
    </div>
  </section>
</Base>
