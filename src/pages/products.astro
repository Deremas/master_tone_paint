---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ProductCard from '../components/ProductCard.astro';
import { products, seo } from '../data/content';
---
<Base title="Products" description={seo.productsDescription}>
  <PageHero
    eyebrow="Products"
    title="Our Products"
    intro="Five product families covering wall preparation through final finish."
  />

  <section class="section">
    <div class="container">
      <div class="product-grid product-grid--text">
        {products.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    </div>
  </section>

  <section class="section section-navy">
    <div class="container callout-simple" data-reveal>
      <h2>Need a product quote?</h2>
      <p>Share the category and volume you need. We will follow up on supply.</p>
      <a class="btn btn-light" href="/contact/#inquiry-form">Request a Quote</a>
    </div>
  </section>
</Base>
