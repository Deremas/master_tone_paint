---
import type { ProductCardData } from '../data/content';

type Props = {
  product: ProductCardData;
};

const { product } = Astro.props as Props;
---
<article class="product-card product-card--text" data-reveal>
  <div class="product-body">
    <h3>{product.title}</h3>
    <p>{product.description}</p>

    {product.capacityValue && (
      <div class="product-capacity">
        <span>{product.capacityLabel}</span>
        <strong>{product.capacityValue}</strong>
      </div>
    )}

    <a class="text-link" href={`/contact/?product=${product.slug}#inquiry-form`}>
      Inquire
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
