---
type IconName =
  | 'vision'
  | 'mission'
  | 'capacity'
  | 'community'
  | 'integrity'
  | 'transparency'
  | 'accountability'
  | 'expansion'
  | 'quality'
  | 'price'
  | 'supply';

type Props = {
  name: IconName;
};

const { name } = Astro.props as Props;
---
<span class="section-icon" aria-hidden="true" data-icon={name}>
  {name === 'vision' && (
    <svg viewBox="0 0 24 24" fill="none">
      <path d="M2.5 12s3.5-6.5 9.5-6.5S21.5 12 21.5 12s-3.5 6.5-9.5 6.5S2.5 12 2.5 12Z" stroke="currentColor" stroke-width="1.7"/>
      <circle cx="12" cy="12" r="2.8" stroke="currentColor" stroke-width="1.7"/>
    </svg>
  )}
  {name === 'mission' && (
    <svg viewBox="0 0 24 24" fill="none">
      <circle cx="12" cy="12" r="8.2" stroke="currentColor" stroke-width="1.7"/>
      <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.7"/>
      <circle cx="12" cy="12" r="1.4" fill="currentColor"/>
    </svg>
  )}
  {name === 'capacity' && (
    <svg viewBox="0 0 24 24" fill="none">
      <path d="M4 19V9.5L8 7l4 3.5L16 7l4 2.5V19" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
      <path d="M4 19h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
      <path d="M8 19v-5h3v5M13 19v-7h3v7" stroke="currentColor" stroke-width="1.7"/>
    </svg>
  )}
  {name === 'community' && (
    <svg viewBox="0 0 24 24" fill="none">
      <circle cx="9" cy="8" r="2.4" stroke="currentColor" stroke-width="1.7"/>
      <circle cx="16" cy="9" r="2" stroke="currentColor" stroke-width="1.7"/>
      <path d="M4.5 18.5c.6-2.8 2.6-4.3 4.5-4.3s3.9 1.5 4.5 4.3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
      <path d="M13.2 18.5c.4-1.8 1.6-3 3-3 1.5 0 2.6 1 3 2.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    </svg>
  )}
  {name === 'integrity' && (
    <svg viewBox="0 0 24 24" fill="none">
      <path d="M12 3.5 19 7v5.2c0 4.2-2.9 7.4-7 8.8-4.1-1.4-7-4.6-7-8.8V7l7-3.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
      <path d="m9.2 12 1.9 1.9 3.8-3.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  )}
  {name === 'transparency' && (
    <svg viewBox="0 0 24 24" fill="none">
      <rect x="4" y="4" width="16" height="16" rx="3" stroke="currentColor" stroke-width="1.7"/>
      <path d="M8 12h8M12 8v8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    </svg>
  )}
  {name === 'accountability' && (
    <svg viewBox="0 0 24 24" fill="none">
      <path d="M7 4h10v16H7V4Z" stroke="currentColor" stroke-width="1.7"/>
      <path d="M10 8h4M10 12h4M10 16h2.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    </svg>
  )}
  {name === 'expansion' && (
    <svg viewBox="0 0 24 24" fill="none">
      <path d="M5 19V9l7-5 7 5v10" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
      <path d="M10 19v-5h4v5" stroke="currentColor" stroke-width="1.7"/>
      <path d="M15 5.5V4h3.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    </svg>
  )}
  {name === 'quality' && (
    <svg viewBox="0 0 24 24" fill="none">
      <path d="m12 3.8 2.1 4.3 4.7.7-3.4 3.3.8 4.7L12 14.7 7.8 16.8l.8-4.7-3.4-3.3 4.7-.7L12 3.8Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
    </svg>
  )}
  {name === 'price' && (
    <svg viewBox="0 0 24 24" fill="none">
      <circle cx="12" cy="12" r="8.2" stroke="currentColor" stroke-width="1.7"/>
      <path d="M12 7.2v9.6M9.4 9.4c.6-1 1.5-1.5 2.6-1.5 1.7 0 2.8 1 2.8 2.3s-1.1 2.2-2.8 2.2h-1.2c-1.7 0-2.9.9-2.9 2.3 0 1.3 1.2 2.3 2.9 2.3 1.2 0 2.1-.5 2.7-1.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    </svg>
  )}
  {name === 'supply' && (
    <svg viewBox="0 0 24 24" fill="none">
      <path d="M3.5 15.5h11V9.2H8.2L6.4 7H3.5v8.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
      <path d="M14.5 11.5h3.4l2.1 2.4v1.6h-5.5" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
      <circle cx="7.2" cy="17.6" r="1.5" stroke="currentColor" stroke-width="1.7"/>
      <circle cx="17.2" cy="17.6" r="1.5" stroke="currentColor" stroke-width="1.7"/>
    </svg>
  )}
</span>
