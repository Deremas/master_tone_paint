---
type Props = {
  eyebrow: string;
  title: string;
  intro: string;
};

const { eyebrow, title, intro } = Astro.props as Props;
---
<section class="page-hero">
  <div class="container page-hero-inner">
    <div class="eyebrow">
      <span class="eyebrow-dot"></span>
      {eyebrow}
    </div>
    <h1>{title}</h1>
    <p>{intro}</p>
  </div>
  <div class="page-hero-decoration" aria-hidden="true"></div>
</section>
