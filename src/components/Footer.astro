---
import { company, footerLinks } from '../data/content';
---
<footer class="footer">
  <div class="container footer-grid footer-grid--three">
    <div>
      <p class="footer-name">{company.shortName}</p>
      <p class="footer-note">{company.tagline}</p>
      <p class="footer-note">{company.shortDescription}</p>
    </div>

    <div>
      <h3 class="footer-heading">Explore</h3>
      <nav class="footer-links" aria-label="Footer navigation">
        {footerLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>
    </div>

    <div>
      <h3 class="footer-heading">Contact</h3>
      <p>{company.location}</p>
      <a href="/contact/#inquiry-form">Request a Quote</a>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} {company.name}. All rights reserved.</span>
  </div>
</footer>
