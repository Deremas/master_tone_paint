---
import { company, footerLinks } from '../data/content';
---
<footer class="footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-name">{company.name}</p>
      <p class="footer-note">{company.shortDescription}</p>
      <p class="footer-note">{company.businessModel}</p>
    </div>

    <div>
      <h3 class="footer-heading">Explore</h3>
      <nav class="footer-links" aria-label="Footer navigation">
        {footerLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>
    </div>

    <div>
      <h3 class="footer-heading">Contact</h3>
      <p>{company.location}</p>
      <a href="/contact/#inquiry-form">Send an Inquiry</a>
      {company.phone && <a href={`tel:${company.phone.replace(/\s+/g, '')}`}>{company.phone}</a>}
      {company.email && <a href={`mailto:${company.email}`}>{company.email}</a>}
    </div>

  </div>

  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} {company.name}. All rights reserved.</span>
  </div>
</footer>
